# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Site Configuration
# Local: http://localhost:3000 (or the port `next dev` uses)
# Production (Vercel): https://www.clearcutlaw.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email
# The form always saves the message in contact_messages. It emails younas.f@outlook.com
# only when both values below are set on the host. Until then the page says the message
# could not be sent, and no email is sent.
# RESEND_API_KEY: API key from a Resend account. The free plan is enough. Do not start a paid plan for this.
# CONTACT_FROM_EMAIL: a bare mailbox on a domain verified in that Resend account, such as hello@clearcutlaw.co.uk
# The From name is ClearCut Law website. The address the visitor types is the reply address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=


